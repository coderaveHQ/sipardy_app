{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "app/lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file=.env.local",
        "--web-port=8080"
      ]
    }
  ]
}